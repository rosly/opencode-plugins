{
  "model": {
    "*": {
      "provider": {
        "order": ["anthropic", "openai"],
        "allow_fallbacks": true,
        "sort": "latency",
        "preferred_max_latency": { "p90": 3 },
        "quantizations": ["int8"]
      },
      "reasoning": {
        "enabled": true,
        "effort": "high",
        "max_tokens": 2000
      },
      "usage": { "include": true },
      "web_search_options": {
        "max_results": 5,
        "engine": "native"
      }
    },
    "openai/*": {
      "provider": {
        "sort": "throughput"
      }
    },
    "openai/gpt-5*, openai/gpt-5-mini*": {
      "provider": {
        "sort": "throughput"
      },
      "models": [
        "google/gemini-3.1-pro",
        "anthropic/claude-sonnet-4-5"
      ]
    },
    "anthropic/claude-sonnet-4-5#high": {
      "provider": {
        "data_collection": "deny",
        "zdr": true,
        "max_price": { "completion": "15", "prompt": "3" }
      },
      "plugins": [
        { "id": "response-healing" }
      ]
    }
  }
}